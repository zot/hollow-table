  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "ws": "8.18.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "0.26.0"
  }
}
